{
  "name": "ind323-ai-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pendamping kuliah IND323 dan bank soal bertimer. Mesin dan kunci jawabannya ditulis dalam Swift.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "budget": "node scripts/budget.mjs",
    "audit:all": "npm run pisah && npm run typecheck && npm run test && npm run build && npm run budget",
    "pisah": "node scripts/pisah-bank.mjs"
  },
  "author": "Daniel Hutajulu (.Deckyx)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb3rpunq/ind323-ai-lab.git"
  },
  "homepage": "https://xyb3rpunq.github.io/ind323-ai-lab/",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^20.12.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
